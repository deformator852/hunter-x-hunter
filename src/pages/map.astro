                  <circle cx="180" cy="180" r="34" /><circle cx="146" cy="200" r="26" /><circle cx="216" cy="204" r="24" />
                  <circle cx="820" cy="160" r="30" /><circle cx="860" cy="184" r="24" />
                  <circle cx="920" cy="480" r="34" /><circle cx="884" cy="510" r="26" />
