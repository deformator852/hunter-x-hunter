---
import Base from '../layouts/Base.astro';
import WorldMap from '../components/WorldMap.vue';
import { knownPlaces, darkPlaces, calamities, legend } from '../data/map';
import { withBase } from '../lib/base';

const known = knownPlaces.map((p) => ({ ...p, image: withBase(p.image), mapIcon: withBase(p.mapIcon) }));
const dark = darkPlaces.map((p) => ({ ...p, image: withBase(p.image), mapIcon: withBase(p.mapIcon) }));
const cals = calamities.map((p) => ({ ...p, image: withBase(p.image), mapIcon: withBase(p.mapIcon) }));
---

<Base title="World Map" description="An interactive vector map of the Hunter x Hunter world — traced from the Association survey chart.">
  <WorldMap client:only="vue" known={known} dark={dark} legend={legend} calamities={cals}>
    <div slot="fallback" class="container" style="padding:3rem 0;text-align:center;color:var(--text-dim)">
      Loading survey chart…
    </div>
  </WorldMap>
</Base>
