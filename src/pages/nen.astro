---
import Base from '../layouts/Base.astro';
import { characters } from '../data/characters.js';
import { portraits } from '../data/portraits.js';

const facesByType = {
  enhancement: ['gon', 'netero'],
  transmutation: ['killua', 'hisoka'],
  conjuration: ['kurapika', 'kite'],
  specialization: ['chrollo'],
  manipulation: [],
  emission: ['leorio'],
};
const faceData = (id) => {
  const c = characters.find((x) => x.id === id);
  return { id, name: c.name.split(' ')[0], color: c.color, portrait: portraits[id] };
};

const principles = [
  {
    id: 'ten',
    name: 'Ten',
    jp: '纏 · Envelop',
    color: '#4fbf67',
    desc: 'Keep the aura flowing around the body instead of leaking away. Ten is the foundation of everything: it protects you from emotional Nen attacks and slows aging. A calm shell of life energy.',
  },
  {
    id: 'zetsu',
    name: 'Zetsu',
    jp: '絶 · Suppress',
    color: '#9aa0ae',
    desc: 'Close all aura nodes and stop the flow entirely. Zetsu hides your presence completely — perfect for stealth and recovering from fatigue — but it leaves the body defenseless against Nen.',
  },
  {
    id: 'ren',
    name: 'Ren',
    jp: '練 · Refine',
    color: '#e63946',
    desc: 'Produce more aura than usual and hold it — a roaring outburst of life energy. Ren is raw output: it powers up strength and durability, and it is what a Hunter flares to intimidate an opponent.',
  },
  {
    id: 'hatsu',
    name: 'Hatsu',
    jp: '発 · Release',
    color: '#f4c95d',
    desc: 'Release and shape your aura into a personal ability. Hatsu is your Nen made manifest — Gon\'s Jajanken, Kurapika\'s chains, Hisoka\'s Bungee Gum. It reflects who you truly are.',
  },
];

const nenTypes = [
  {
    id: 'enhancement', name: 'Enhancement', color: '#ff5c4d', x: 200, y: 42,
    water: 'The volume of the water increases and overflows the glass.',
    personality: 'Simple and determined. They say what they mean and never back down.',
    users: 'Gon, Netero, Uvogin, Phinks',
    desc: 'Strengthen what already exists — the body, an object, a blow. Enhancers are the most balanced fighters, turning raw aura directly into overwhelming physical power.',
  },
  {
    id: 'transmutation', name: 'Transmutation', color: '#58c9e8', x: 62, y: 122,
    water: 'The taste of the water changes.',
    personality: 'Whimsical and prone to lying. Unique personalities no one can pin down.',
    users: 'Killua, Hisoka, Biscuit, Machi',
    desc: 'Change the properties of your aura — make it electricity, gum, sharpened wire. Transmuters mimic qualities of things, creating abilities that are famously hard to read.',
  },
  {
    id: 'conjuration', name: 'Conjuration', color: '#b48ef2', x: 62, y: 278,
    water: 'Impurities appear in the water.',
    personality: 'High-strung and observant. Careful people who thrive on rules and conditions.',
    users: 'Kurapika, Kite, Kortopi, Shizuku',
    desc: 'Materialize real, physical objects out of aura — chains, weapons, even a vacuum cleaner. Conjured items can carry powerful conditions that push them beyond physics.',
  },
  {
    id: 'specialization', name: 'Specialization', color: '#f45fc0', x: 200, y: 358,
    water: 'Something else entirely happens.',
    personality: 'Independent and charismatic. Individualists who follow no template.',
    users: 'Chrollo, Kurapika (Emperor Time), Neferpitou, Meruem',
    desc: 'Anything that fits no other category: stealing abilities, manipulating fate, perfect prophecy. You cannot train your way here — Specialization chooses you.',
  },
  {
    id: 'manipulation', name: 'Manipulation', color: '#ffcd4d', x: 338, y: 278,
    water: 'The leaf moves across the surface of the water.',
    personality: 'Logical debaters who like to control the pace — and sometimes people.',
    users: 'Illumi, Shalnark, Morel, Squala',
    desc: 'Control things — objects, animals, people — by attaching your aura to them. Manipulators win from a distance; one touch of their condition can decide the entire fight.',
  },
  {
    id: 'emission', name: 'Emission', color: '#6fe08a', x: 338, y: 122,
    water: 'The color of the water changes.',
    personality: 'Impatient, hot-blooded and quick to act — and quick to cool down.',
    users: 'Leorio, Razor, Franklin, Knuckle',
    desc: 'Detach aura from the body and keep it dense at range — energy blasts, warp gates, remote beasts. Emitters turn distance from a weakness into a weapon.',
  },
];

const quiz = [
  {
    q: 'Your friend is in danger behind a locked steel door. You…',
    a: [
      { t: 'enhancement', text: 'Punch it down. Repeatedly. It WILL open.' },
      { t: 'transmutation', text: 'Slip something slippery/sharp/weird through the hinges.' },
      { t: 'manipulation', text: 'Find whoever has the key and make them open it.' },
      { t: 'conjuration', text: 'You already carry exactly the right tool for this.' },
    ],
  },
  {
    q: 'How do people usually describe you?',
    a: [
      { t: 'enhancement', text: 'Straightforward — maybe a little too honest.' },
      { t: 'transmutation', text: 'Unpredictable. Half of what I say is a joke. Which half? Hmm.' },
      { t: 'emission', text: 'Impatient and loud, but my heart is in the right place.' },
      { t: 'specialization', text: 'They don\'t. Nobody really knows me.' },
    ],
  },
  {
    q: 'Pick a training montage:',
    a: [
      { t: 'enhancement', text: '10,000 punches a day. Gratitude included.' },
      { t: 'conjuration', text: 'Study one object for weeks until I can draw it from memory.' },
      { t: 'manipulation', text: 'Chess, arguments, and puppets.' },
      { t: 'emission', text: 'Throwing my aura as far and hard as it can go.' },
    ],
  },
  {
    q: 'Your ideal Nen ability sounds like…',
    a: [
      { t: 'transmutation', text: 'My aura becomes something with strange, gross, wonderful properties.' },
      { t: 'conjuration', text: 'A weapon with strict rules that make it absurdly strong.' },
      { t: 'specialization', text: 'Something nobody else in the world could ever copy.' },
      { t: 'emission', text: 'A remote strike I can deliver from another city.' },
    ],
  },
  {
    q: 'In a team, you are the one who…',
    a: [
      { t: 'enhancement', text: 'Stands at the front and takes the hit.' },
      { t: 'manipulation', text: 'Makes the plan — and quietly makes everyone follow it.' },
      { t: 'transmutation', text: 'Does the thing no one predicted, including me.' },
      { t: 'specialization', text: 'Works alone. The team finds out later.' },
    ],
  },
  {
    q: 'What would you hunt?',
    a: [
      { t: 'enhancement', text: 'The strongest opponent alive.' },
      { t: 'conjuration', text: 'A lost relic everyone says is just a legend.' },
      { t: 'emission', text: 'Anything — as long as we leave RIGHT NOW.' },
      { t: 'manipulation', text: 'The truth behind a conspiracy.' },
    ],
  },
];
---

<Base title="Nen" description="An interactive guide to Nen from Hunter x Hunter: the four principles, six aura types, and the water divination test.">
  <section class="page-head container">
    <span class="section-kicker">FORBIDDEN CURRICULUM · FLOOR 200 AND ABOVE</span>
    <h1 class="section-title"><span class="accent-g">Nen</span> — The Power of Life Energy</h1>
    <p class="page-sub">
      Every living body leaks a life energy called <strong>aura</strong>. Nen is the discipline of
      controlling it — the secret that separates floor 199 of Heavens Arena from floor 200.
    </p>
  </section>

  <!-- ============ FOUR PRINCIPLES ============ -->
  <section class="section container">
    <span class="section-kicker reveal">LESSON ONE</span>
    <h2 class="section-title reveal">The Four <span class="accent">Principles</span></h2>
    <div class="principles card reveal">
      <div class="aura-stage" aria-hidden="true">
        <svg viewBox="0 0 200 260" class="aura-figure" id="aura-figure">
          <!-- aura layers -->
          <g class="aura-layer aura-outer">
            <ellipse cx="100" cy="140" rx="78" ry="112" fill="var(--aura-color, #4fbf67)" opacity="0.10" />
          </g>
          <g class="aura-layer aura-mid">
            <ellipse cx="100" cy="140" rx="60" ry="94" fill="var(--aura-color, #4fbf67)" opacity="0.16" />
          </g>
          <g class="aura-layer aura-inner">
            <ellipse cx="100" cy="140" rx="44" ry="78" fill="var(--aura-color, #4fbf67)" opacity="0.22" />
          </g>
          <!-- hatsu beam -->
          <g class="hatsu-beam">
            <path d="M100 96 L172 40 l-8 22 26 -6 -34 34z" fill="var(--aura-color, #f4c95d)" opacity="0.85" />
          </g>
          <!-- figure -->
          <g fill="#0e1118" stroke="#39415a" stroke-width="2.5">
            <circle cx="100" cy="66" r="20" />
            <path d="M100 88 c-24 0 -34 18 -36 42 l-6 52 h16 l6 -38 4 96 h14 l2 -60 2 60 h14 l4 -96 6 38 h16 l-6 -52 c-2 -24 -12 -42 -36 -42z" />
          </g>
        </svg>
      </div>
      <div class="principles-panel">
        <div class="principle-tabs" role="tablist" aria-label="Nen principles">
          {principles.map((p, i) => (
            <button
              class:list={['p-tab', { active: i === 0 }]}
              role="tab"
              aria-selected={i === 0 ? 'true' : 'false'}
              data-principle={p.id}
              data-color={p.color}
              style={`--pc:${p.color}`}
            >{p.name}</button>
          ))}
        </div>
        {principles.map((p, i) => (
          <div class:list={['p-body', { active: i === 0 }]} data-body={p.id}>
            <div class="p-jp" style={`color:${p.color}`}>{p.jp}</div>
            <p>{p.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ============ SIX TYPES HEXAGON ============ -->
  <section class="section container">
    <span class="section-kicker reveal">LESSON TWO</span>
    <h2 class="section-title reveal">The Six <span class="accent-g">Aura Types</span></h2>
    <p class="page-sub reveal">
      Everyone is born leaning toward one of six categories — drawn exactly as Wing drew it. Click a
      type: your training efficiency in the others depends on how close they sit on the chart
      (<strong>100%</strong> yours · <strong>80%</strong> adjacent · <strong>60%</strong> next ·
      <strong>40%</strong> across).
    </p>
    <div class="hex-wrap card reveal">
      <svg viewBox="0 0 400 400" class="hex-chart" id="hex-chart" role="group" aria-label="Nen type chart">
        <!-- hexagon frame -->
        <polygon
          points="200,42 338,122 338,278 200,358 62,278 62,122"
          fill="none" stroke="var(--line)" stroke-width="2"
        />
        <!-- spokes -->
        {nenTypes.map((t) => (
          <line x1="200" y1="200" x2={t.x} y2={t.y} stroke="var(--line)" stroke-width="1" stroke-dasharray="3 5" />
        ))}
        <circle cx="200" cy="200" r="4" fill="var(--text-dim)" />
        {nenTypes.map((t) => (
          <g
            class="hex-node"
            data-type={t.id}
            tabindex="0"
            role="button"
            aria-label={`${t.name} Nen type`}
            style={`--tc:${t.color}`}
          >
            <circle cx={t.x} cy={t.y} r="30" class="hex-dot" />
            <circle cx={t.x} cy={t.y} r="30" class="hex-ring" />
            <text x={t.x} y={t.y + 1} text-anchor="middle" class="hex-pct" data-pct-for={t.id}>·</text>
            <text
              x={t.x}
              y={t.y + (t.y < 200 ? -42 : 54)}
              text-anchor="middle"
              class="hex-label"
            >{t.name}</text>
          </g>
        ))}
      </svg>
      <div class="hex-info" id="hex-info">
        <p class="hex-hint">☝ Click any of the six types on the chart to open its file.</p>
        {nenTypes.map((t) => (
          <div class="hex-detail" data-detail={t.id} hidden>
            <h3 style={`color:${t.color}`}>{t.name}</h3>
            <p class="hex-desc">{t.desc}</p>
            <div class="hex-meta">
              <div><span class="hex-meta-k">Water test</span>{t.water}</div>
              <div><span class="hex-meta-k">Personality</span>{t.personality}</div>
              <div><span class="hex-meta-k">Known users</span>{t.users}</div>
            </div>
            {facesByType[t.id].length > 0 && (
              <div class="hex-faces">
                {facesByType[t.id].map((fid) => {
                  const f = faceData(fid);
                  return (
                    <a class="hex-face" href="/characters" style={`--fc:${f.color}`} title={`${f.name} — see dossier`}>
                      <span class="hex-face-art" set:html={f.portrait} />
                      <span class="hex-face-name">{f.name}</span>
                    </a>
                  );
                })}
              </div>
            )}
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ============ WATER DIVINATION ============ -->
  <section class="section container">
    <span class="section-kicker reveal">LESSON THREE</span>
    <h2 class="section-title reveal">Water <span class="accent">Divination</span></h2>
    <p class="page-sub reveal">
      A glass of water, a floating leaf, and your Ren. Answer six questions the way Hisoka would
      profile you — then watch what your aura does to the glass.
    </p>

    <div class="divination card reveal" id="divination">
      <!-- quiz -->
      <div class="quiz" id="quiz">
        <div class="quiz-progress"><div class="quiz-bar" id="quiz-bar"></div></div>
        <div id="quiz-question"></div>
      </div>

      <!-- result -->
      <div class="result" id="result" hidden>
        <div class="glass-stage">
          <svg viewBox="0 0 220 260" class="glass-svg" id="glass-svg" aria-hidden="true">
            <defs>
              <clipPath id="glass-clip">
                <path d="M60 40 L74 220 a12 12 0 0 0 12 10 h48 a12 12 0 0 0 12 -10 L160 40 Z" />
              </clipPath>
            </defs>
            <!-- table -->
            <rect x="20" y="230" width="180" height="8" rx="4" fill="#2a3040" />
            <!-- water (clipped) -->
            <g clip-path="url(#glass-clip)">
              <rect id="water" x="50" y="120" width="120" height="120" fill="#58b3e0" opacity="0.5" />
              <g id="impurities" opacity="0">
                <circle cx="95" cy="150" r="3" fill="#cbd2e0" />
                <circle cx="120" cy="175" r="4" fill="#cbd2e0" />
                <circle cx="105" cy="195" r="2.5" fill="#cbd2e0" />
                <circle cx="130" cy="150" r="2.5" fill="#cbd2e0" />
                <circle cx="88" cy="182" r="3.5" fill="#cbd2e0" />
              </g>
            </g>
            <!-- overflow drips -->
            <g id="overflow" opacity="0">
              <path d="M62 46 q-4 18 -8 26" stroke="#58b3e0" stroke-width="4" fill="none" stroke-linecap="round" />
              <path d="M158 46 q4 18 8 26" stroke="#58b3e0" stroke-width="4" fill="none" stroke-linecap="round" />
            </g>
            <!-- glass outline -->
            <path
              d="M60 40 L74 220 a12 12 0 0 0 12 10 h48 a12 12 0 0 0 12 -10 L160 40 Z"
              fill="rgba(255,255,255,0.05)" stroke="#8b94a8" stroke-width="3"
            />
            <!-- leaf -->
            <g id="leaf">
              <ellipse cx="110" cy="120" rx="16" ry="6" fill="#4fbf67" />
              <path d="M96 120 h28" stroke="#2e7d43" stroke-width="1.5" />
            </g>
            <!-- sparkles (transmutation / specialization) -->
            <g id="sparkles" opacity="0" fill="#f4c95d">
              <path d="M70 80 l3 8 8 3 -8 3 -3 8 -3 -8 -8 -3 8 -3z" />
              <path d="M150 70 l2.5 6 6 2.5 -6 2.5 -2.5 6 -2.5 -6 -6 -2.5 6 -2.5z" />
              <path d="M135 100 l2 5 5 2 -5 2 -2 5 -2 -5 -5 -2 5 -2z" />
            </g>
            <!-- hands doing ren -->
            <g fill="none" stroke="#39415a" stroke-width="3" opacity="0.9">
              <path d="M14 150 q20 -8 34 4 M14 168 q20 -6 32 4" stroke-linecap="round" />
              <path d="M206 150 q-20 -8 -34 4 M206 168 q-20 -6 -32 4" stroke-linecap="round" />
            </g>
          </svg>
        </div>
        <div class="result-copy">
          <div class="result-kicker">YOUR AURA TYPE</div>
          <h3 class="result-name" id="result-name"></h3>
          <p class="result-water" id="result-water"></p>
          <p class="result-desc" id="result-desc"></p>
          <p class="result-users" id="result-users"></p>
          <button class="btn btn-ghost" id="quiz-retry">Divine Again</button>
        </div>
      </div>
    </div>
  </section>
</Base>

<script define:vars={{ quiz, nenTypes }}>
  window.__NEN_QUIZ__ = quiz;
  window.__NEN_TYPES__ = nenTypes;
</script>

<style>
  .page-head { padding: 3.2rem 0 0; text-align: center; }
  .page-sub { color: var(--text-dim); max-width: 640px; margin: 0 auto 1.4rem; }
  .page-sub strong { color: var(--hxh-gold); }
  .section { padding: 4rem 0 0; }

  /* ---------- principles ---------- */
  .principles {
    display: grid;
    grid-template-columns: 300px 1fr;
    gap: 1.5rem;
    padding: 2rem;
    margin-top: 1.8rem;
    align-items: center;
  }
  @media (max-width: 760px) { .principles { grid-template-columns: 1fr; } }
  .aura-stage { display: grid; place-items: center; }
  .aura-figure { width: 100%; max-width: 260px; }

  .aura-layer { transform-origin: 100px 140px; transition: opacity 0.5s, transform 0.5s; }
  .hatsu-beam { opacity: 0; transform-origin: 100px 96px; transition: opacity 0.4s; }

  /* per-principle states set via data attribute on the svg */
  #aura-figure[data-state='ten'] .aura-outer { opacity: 0; }
  #aura-figure[data-state='ten'] .aura-mid { opacity: 0.55; animation: aura-pulse 3.2s ease-in-out infinite; }
  #aura-figure[data-state='ten'] .aura-inner { opacity: 1; animation: aura-pulse 3.2s ease-in-out infinite; }

  #aura-figure[data-state='zetsu'] .aura-layer { opacity: 0; }

  #aura-figure[data-state='ren'] .aura-outer { opacity: 1; animation: aura-pulse 0.9s ease-in-out infinite; }
  #aura-figure[data-state='ren'] .aura-mid { opacity: 1; animation: aura-pulse 0.9s ease-in-out infinite 0.15s; }
  #aura-figure[data-state='ren'] .aura-inner { opacity: 1; animation: flicker 1.4s linear infinite; }

  #aura-figure[data-state='hatsu'] .aura-outer { opacity: 0.35; }
  #aura-figure[data-state='hatsu'] .aura-mid { opacity: 0.5; }
  #aura-figure[data-state='hatsu'] .aura-inner { opacity: 0.8; animation: aura-pulse 1.6s ease-in-out infinite; }
  #aura-figure[data-state='hatsu'] .hatsu-beam { opacity: 1; animation: flicker 1.1s linear infinite; }

  .principle-tabs { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 1.1rem; }
  .p-tab {
    font-family: var(--font-display);
    font-size: 1.02rem;
    letter-spacing: 0.06em;
    padding: 0.5rem 1.2rem;
    border-radius: 10px;
    border: 2px solid var(--line);
    background: var(--panel-2);
    color: var(--text-dim);
    transition: all 0.2s;
  }
  .p-tab:hover { border-color: var(--pc); color: var(--text); transform: translateY(-2px); }
  .p-tab.active {
    border-color: var(--pc);
    color: var(--pc);
    background: color-mix(in srgb, var(--pc) 12%, transparent);
    box-shadow: 0 0 18px -4px var(--pc);
  }
  .p-body { display: none; }
  .p-body.active { display: block; animation: pop-in 0.35s; }
  .p-jp { font-weight: 700; letter-spacing: 0.2em; font-size: 0.85rem; margin-bottom: 0.4rem; }
  .p-body p { color: var(--text-dim); margin: 0; }

  /* ---------- hexagon ---------- */
  .hex-wrap {
    display: grid;
    grid-template-columns: minmax(300px, 440px) 1fr;
    gap: 1.6rem;
    padding: 1.6rem;
    margin-top: 1.8rem;
    align-items: center;
  }
  @media (max-width: 820px) { .hex-wrap { grid-template-columns: 1fr; } }
  .hex-chart { width: 100%; }
  .hex-node { cursor: pointer; outline: none; }
  .hex-dot {
    fill: var(--panel-2);
    stroke: var(--tc);
    stroke-width: 2.5;
    transition: fill 0.25s, r 0.25s;
  }
  .hex-ring {
    fill: none;
    stroke: var(--tc);
    stroke-width: 2;
    opacity: 0;
    transform-origin: center;
    transform-box: fill-box;
  }
  .hex-node:hover .hex-dot, .hex-node:focus-visible .hex-dot { fill: color-mix(in srgb, var(--tc) 25%, var(--panel-2)); }
  .hex-node.selected .hex-dot { fill: var(--tc); }
  .hex-node.selected .hex-ring { opacity: 1; animation: ring-out 1.6s ease-out infinite; }
  @keyframes ring-out {
    0% { transform: scale(1); opacity: 0.9; }
    100% { transform: scale(1.75); opacity: 0; }
  }
  .hex-pct {
    fill: var(--text);
    font-family: var(--font-body);
    font-size: 13px;
    font-weight: 700;
    dominant-baseline: middle;
    pointer-events: none;
  }
  .hex-node.selected .hex-pct { fill: #0b0d12; }
  .hex-label {
    fill: var(--text-dim);
    font-family: var(--font-body);
    font-size: 13.5px;
    font-weight: 700;
    letter-spacing: 0.04em;
    pointer-events: none;
    transition: fill 0.25s;
  }
  .hex-node.selected .hex-label, .hex-node:hover .hex-label { fill: var(--tc); }

  .hex-hint { color: var(--text-dim); font-weight: 600; }
  .hex-detail { animation: pop-in 0.35s; }
  .hex-detail h3 { font-size: 1.5rem; }
  .hex-desc { color: var(--text-dim); }
  .hex-meta { display: grid; gap: 0.55rem; font-size: 0.9rem; margin-top: 0.9rem; }
  .hex-meta-k {
    display: inline-block;
    min-width: 108px;
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--hxh-gold);
  }
  .hex-faces { display: flex; gap: 0.8rem; margin-top: 1.1rem; }
  .hex-face {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.25rem;
    text-decoration: none;
    color: var(--text-dim);
    font-size: 0.72rem;
    font-weight: 700;
  }
  .hex-face-art {
    width: 62px;
    height: 62px;
    border-radius: 50%;
    overflow: hidden;
    background:
      radial-gradient(ellipse at 50% 25%, color-mix(in srgb, var(--fc) 40%, transparent), transparent 75%),
      linear-gradient(180deg, var(--panel-2), #0e1118);
    border: 2px solid color-mix(in srgb, var(--fc) 50%, var(--line));
    transition: transform 0.25s;
  }
  .hex-face:hover .hex-face-art { transform: scale(1.12); }
  .hex-face:hover { color: var(--fc); }
  .hex-face-art :global(svg) { width: 100%; height: 132%; display: block; }

  /* ---------- divination ---------- */
  .divination { padding: 2rem; margin-top: 1.8rem; }
  .quiz-progress {
    height: 8px;
    border-radius: 6px;
    background: var(--panel-2);
    overflow: hidden;
    margin-bottom: 1.5rem;
  }
  .quiz-bar {
    height: 100%;
    width: 0;
    border-radius: 6px;
    background: linear-gradient(90deg, var(--hxh-green), var(--hxh-gold));
    transition: width 0.45s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .quiz :global(.q-text) {
    font-family: var(--font-display);
    font-size: 1.3rem;
    letter-spacing: 0.03em;
    margin: 0 0 1.1rem;
    animation: pop-in 0.3s;
  }
  .quiz :global(.q-answers) { display: grid; gap: 0.6rem; }
  @media (min-width: 720px) { .quiz :global(.q-answers) { grid-template-columns: 1fr 1fr; } }
  .quiz :global(.q-answer) {
    text-align: left;
    background: var(--panel-2);
    border: 1px solid var(--line);
    border-radius: 10px;
    color: var(--text);
    padding: 0.85rem 1.1rem;
    font-size: 0.94rem;
    transition: all 0.18s;
    animation: pop-in 0.35s backwards;
  }
  .quiz :global(.q-answer:hover) {
    border-color: var(--hxh-green);
    background: color-mix(in srgb, var(--hxh-green) 10%, var(--panel-2));
    transform: translateX(4px);
  }

  /* result */
  .result {
    display: grid;
    grid-template-columns: 260px 1fr;
    gap: 2rem;
    align-items: center;
    animation: pop-in 0.5s;
  }
  @media (max-width: 700px) { .result { grid-template-columns: 1fr; } }
  .glass-stage { display: grid; place-items: center; }
  .glass-svg { width: 100%; max-width: 240px; }

  #water { transition: y 1.6s ease, height 1.6s ease, fill 1.6s ease; }
  #leaf { transition: transform 1.6s ease-in-out, filter 1s; }
  #impurities, #overflow, #sparkles { transition: opacity 0.9s ease 0.7s; }

  .glass-svg.fx-enhancement #water { y: 44px; height: 196px; }
  .glass-svg.fx-enhancement #leaf { transform: translateY(-74px); }
  .glass-svg.fx-enhancement #overflow { opacity: 1; }
  .glass-svg.fx-emission #water { fill: #b44df0; opacity: 0.65; }
  .glass-svg.fx-transmutation #sparkles { opacity: 1; }
  .glass-svg.fx-conjuration #impurities { opacity: 1; }
  .glass-svg.fx-manipulation #leaf { transform: translateX(34px) rotate(14deg); }
  .glass-svg.fx-specialization #leaf { filter: drop-shadow(0 0 8px #f45fc0) hue-rotate(220deg); transform: translateY(-16px); }
  .glass-svg.fx-specialization #sparkles { opacity: 1; fill: #f45fc0; }

  .result-kicker { font-size: 0.7rem; font-weight: 700; letter-spacing: 0.3em; color: var(--hxh-gold); }
  .result-name { font-size: 2.1rem; margin: 0.15rem 0 0.6rem; }
  .result-water { font-weight: 700; color: var(--text); }
  .result-desc, .result-users { color: var(--text-dim); font-size: 0.95rem; }
  #quiz-retry { margin-top: 0.4rem; }
</style>

<script>
  // ================= principles =================
  const figure = document.getElementById('aura-figure')!;
  figure.dataset.state = 'ten';
  document.querySelectorAll<HTMLButtonElement>('.p-tab').forEach((tab) => {
    tab.addEventListener('click', () => {
      document.querySelectorAll('.p-tab').forEach((t) => {
        t.classList.remove('active');
        t.setAttribute('aria-selected', 'false');
      });
      tab.classList.add('active');
      tab.setAttribute('aria-selected', 'true');
      const id = tab.dataset.principle!;
      figure.dataset.state = id;
      figure.style.setProperty('--aura-color', tab.dataset.color!);
      document.querySelectorAll<HTMLElement>('.p-body').forEach((b) => {
        b.classList.toggle('active', b.dataset.body === id);
      });
    });
  });

  // ================= hexagon =================
  const order = ['enhancement', 'transmutation', 'conjuration', 'specialization', 'manipulation', 'emission'];
  const pctByDistance = [100, 80, 60, 40];

  function selectType(id: string) {
    const idx = order.indexOf(id);
    document.querySelectorAll<SVGGElement>('.hex-node').forEach((node) => {
      const nIdx = order.indexOf(node.dataset.type!);
      const dist = Math.min(Math.abs(nIdx - idx), 6 - Math.abs(nIdx - idx));
      node.classList.toggle('selected', node.dataset.type === id);
      const pct = node.querySelector('.hex-pct')!;
      pct.textContent = pctByDistance[dist] + '%';
    });
    document.querySelectorAll<HTMLElement>('.hex-detail').forEach((d) => {
      d.hidden = d.dataset.detail !== id;
    });
    (document.querySelector('.hex-hint') as HTMLElement).hidden = true;
  }

  document.querySelectorAll<SVGGElement>('.hex-node').forEach((node) => {
    node.addEventListener('click', () => selectType(node.dataset.type!));
    node.addEventListener('keydown', (e) => {
      if ((e as KeyboardEvent).key === 'Enter' || (e as KeyboardEvent).key === ' ') {
        e.preventDefault();
        selectType(node.dataset.type!);
      }
    });
  });

  // ================= water divination quiz =================
  const quiz = (window as any).__NEN_QUIZ__ as { q: string; a: { t: string; text: string }[] }[];
  const nenTypes = (window as any).__NEN_TYPES__ as any[];
  const quizEl = document.getElementById('quiz')!;
  const questionEl = document.getElementById('quiz-question')!;
  const barEl = document.getElementById('quiz-bar')!;
  const resultEl = document.getElementById('result')!;
  const glass = document.getElementById('glass-svg')!;

  let step = 0;
  let tally: Record<string, number> = {};

  function renderQuestion() {
    const q = quiz[step];
    barEl.style.width = `${(step / quiz.length) * 100}%`;
    questionEl.innerHTML = `
      <p class="q-text">${step + 1} / ${quiz.length} — ${q.q}</p>
      <div class="q-answers">
        ${q.a
          .map(
            (a, i) =>
              `<button class="q-answer" data-t="${a.t}" style="animation-delay:${i * 0.07}s">${a.text}</button>`
          )
          .join('')}
      </div>`;
  }

  questionEl.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLElement>('.q-answer');
    if (!btn) return;
    const t = btn.dataset.t!;
    tally[t] = (tally[t] || 0) + 1;
    step++;
    if (step < quiz.length) {
      renderQuestion();
    } else {
      barEl.style.width = '100%';
      showResult();
    }
  });

  function showResult() {
    const winnerId = Object.entries(tally).sort((a, b) => b[1] - a[1])[0][0];
    const type = nenTypes.find((t) => t.id === winnerId)!;
    quizEl.hidden = true;
    resultEl.hidden = false;
    (document.getElementById('result-name') as HTMLElement).textContent = type.name;
    (document.getElementById('result-name') as HTMLElement).style.color = type.color;
    (document.getElementById('result-water') as HTMLElement).textContent = '💧 ' + type.water;
    (document.getElementById('result-desc') as HTMLElement).textContent = type.desc;
    (document.getElementById('result-users') as HTMLElement).textContent = 'You share a type with: ' + type.users;
    glass.className.baseVal = 'glass-svg';
    requestAnimationFrame(() =>
      requestAnimationFrame(() => glass.classList.add('fx-' + winnerId))
    );
    resultEl.scrollIntoView({ behavior: 'smooth', block: 'center' });
  }

  document.getElementById('quiz-retry')!.addEventListener('click', () => {
    step = 0;
    tally = {};
    glass.className.baseVal = 'glass-svg';
    resultEl.hidden = true;
    quizEl.hidden = false;
    renderQuestion();
  });

  renderQuestion();
</script>
