---
import '../styles/global.css';
import SiteEffects from '../components/SiteEffects.vue';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'A fan-made tribute to Yoshihiro Togashi\'s Hunter x Hunter — characters, Nen, and the world map.' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const path = Astro.url.pathname.replace(/\/$/, '') || '/';

const links = [
  { href: base || '/', label: 'Home' },
  { href: `${base}/characters`, label: 'Characters' },
  { href: `${base}/nen`, label: 'Nen' },
  { href: `${base}/map`, label: 'World Map' },
  { href: `${base}/contact`, label: 'Contact' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title} · Hunter × Hunter Fan Site</title>
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Luckiest+Guy&family=Rubik:ital,wght@0,400;0,600;0,700;1,400&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <header class="site-header">
      <nav class="nav container" aria-label="Main navigation">
        <a class="brand" href={base || '/'}>
          <svg class="x-mark" viewBox="0 0 40 40" aria-hidden="true">
            <g stroke-linecap="round" stroke-width="7">
              <line x1="8" y1="8" x2="32" y2="32" stroke="#e63946" />
              <line x1="32" y1="8" x2="8" y2="32" stroke="#4fbf67" />
            </g>
          </svg>
          <span class="hxh-letters" aria-label="Hunter x Hunter">
            {'HUNTER×HUNTER'.split('').map((ch) => <span>{ch}</span>)}
          </span>
        </a>
        <button class="nav-toggle" aria-label="Toggle menu" aria-expanded="false">☰</button>
        <ul class="nav-links">
          {links.map((l) => (
            <li>
              <a href={l.href} aria-current={path === (l.href.replace(/\/$/, '') || '/') ? 'page' : undefined}>{l.label}</a>
            </li>
          ))}
        </ul>
      </nav>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container">
        <div class="hxh-letters">
          {'HUNTER×HUNTER'.split('').map((ch) => <span>{ch}</span>)}
        </div>
        <p>
          Hunter × Hunter and all related characters, artwork and trademarks are the property of their respective copyright holders. This is an unofficial fan-made encyclopedia.
        </p>
      </div>
    </footer>

    <SiteEffects client:load />
  </body>
</html>
