---
import Base from '../layouts/Base.astro';

const knownPlaces = [
  {
    id: 'whale', name: 'Whale Island', x: 618, y: 470, color: '#4fbf67',
    text: 'A sleepy fishing island shaped like a breaching whale. Gon grew up here with his aunt Mito — and caught the Lord of the Lake to earn his ticket to the Hunter Exam.',
  },
  {
    id: 'zaban', name: 'Zaban City', x: 315, y: 330, color: '#f4c95d',
    text: 'Host of the 287th Hunter Exam. Its entrance hid under a modest noodle shop — the first of many tricks played on 404 hopeful applicants.',
  },
  {
    id: 'heavens', name: 'Heavens Arena', x: 385, y: 250, color: '#58b3e0',
    text: 'A 991-meter tower where 4,000 fighters battle daily. Above floor 200, prize money disappears — and Nen becomes the entry fee.',
  },
  {
    id: 'kukuroo', name: 'Kukuroo Mountain', x: 448, y: 348, color: '#9b6fd4',
    text: 'A dormant 3,722 m volcano in the Republic of Padokea. The entire mountain is the Zoldyck family estate — the front gate alone weighs over 200 tonnes.',
  },
  {
    id: 'yorknew', name: 'Yorknew City', x: 700, y: 265, color: '#e63946',
    text: 'The world\'s commercial capital. Every September its Underground Auction draws the mafia, the Phantom Troupe, and one Kurta with chains.',
  },
  {
    id: 'meteor', name: 'Meteor City', x: 782, y: 355, color: '#9aa0ae',
    text: 'A junkyard city of ten million people who officially do not exist. Reject everything, accept everyone. The Phantom Troupe was born here.',
  },
  {
    id: 'greed', name: 'Greed Island', x: 540, y: 548, color: '#f08c3a',
    text: 'A Nen-made island disguised as a video game cartridge. Buy-in: 8.9 billion jenny. Ging Freecss and friends built it — and hid a message for his son inside.',
  },
  {
    id: 'ngl', name: 'NGL', x: 205, y: 470, color: '#ff5c4d',
    text: 'The Neo-Green Life kingdom banned all technology — which made it the perfect nest for the Chimera Ant Queen and her growing colony.',
  },
  {
    id: 'gorteau', name: 'East Gorteau', x: 285, y: 540, color: '#f45fc0',
    text: 'A dictatorship of 26 million that Meruem\'s royal guard turned into a selection ground. The palace of Peijin hosted the story\'s most devastating night.',
  },
];

const darkPlaces = [
  {
    id: 'gate', name: 'Gateway to the New World', x: 500, y: 208, color: '#f4c95d',
    text: 'The colossal door in the Mobius wall through which V5 expeditions depart. Beyond it: a land that has erased 149 expeditions... out of 149.',
  },
  {
    id: 'brion', name: 'Brion', x: 240, y: 120, color: '#ff5c4d',
    text: 'CALAMITY · A botanical weapon guarding ancient ruins — a sphere-headed colossus that hunts anything that moves. Threat rank: B.',
  },
  {
    id: 'hellbell', name: 'Hellbell', x: 762, y: 118, color: '#9b6fd4',
    text: 'CALAMITY · The twin snake of mutual destruction. It kills through the human desire for revenge. Threat rank: A.',
  },
  {
    id: 'ai', name: 'Ai', x: 872, y: 400, color: '#f45fc0',
    text: 'CALAMITY · A gaseous life form — "the codependence of desire." It whispers, and people walk into it smiling. Nanika came from here. Threat rank: A+.',
  },
  {
    id: 'zobae', name: 'Zobae Disease', x: 126, y: 420, color: '#6fe08a',
    text: 'CALAMITY · An immortality sickness. Its sole survivor came back undying — and permanently hungry. Threat rank: B+.',
  },
  {
    id: 'pap', name: 'Pap', x: 500, y: 628, color: '#58c9e8',
    text: 'CALAMITY · A two-tailed beast of unconditional love. Its victims return as empty, blissful husks. Threat rank: B.',
  },
];
---

<Base title="World Map" description="An interactive map of the Hunter x Hunter world — the known continents, and the Dark Continent beyond Lake Mobius.">
  <section class="page-head container">
    <span class="section-kicker">CARTOGRAPHY DIVISION · CLEARANCE LEVEL ★★</span>
    <h1 class="section-title">The <span class="accent-g">World</span> — and What Lies <span class="accent">Beyond</span></h1>
    <p class="page-sub">
      Click the markers to read the field notes. Then, when you're ready, request clearance to see
      the map they don't show civilians.
    </p>
    <div class="view-toggle" role="group" aria-label="Map view">
      <button class="vt-btn active" id="btn-known">Known World</button>
      <button class="vt-btn vt-dark" id="btn-dark">⚠ The True Map</button>
    </div>
  </section>

  <section class="container">
    <div class="map-frame card" id="map-frame">
      <svg viewBox="0 0 1000 700" class="world-map" id="world-map" aria-label="Map of the Hunter x Hunter world">
        <defs>
          <radialGradient id="sea" cx="50%" cy="42%" r="80%">
            <stop offset="0%" stop-color="#16395c" />
            <stop offset="55%" stop-color="#0f2a46" />
            <stop offset="100%" stop-color="#081525" />
          </radialGradient>
          <radialGradient id="dark-sea" cx="50%" cy="50%" r="62%">
            <stop offset="0%" stop-color="#25436b" />
            <stop offset="70%" stop-color="#122238" />
            <stop offset="100%" stop-color="#070d17" />
          </radialGradient>
          <radialGradient id="calamity-glow" cx="50%" cy="50%" r="50%">
            <stop offset="0%" stop-color="#e63946" stop-opacity="0.5" />
            <stop offset="100%" stop-color="#e63946" stop-opacity="0" />
          </radialGradient>
          <linearGradient id="land-a" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0%" stop-color="#3a7a4c" />
            <stop offset="100%" stop-color="#255839" />
          </linearGradient>
          <linearGradient id="land-b" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0%" stop-color="#43855a" />
            <stop offset="100%" stop-color="#2a5f40" />
          </linearGradient>
          <pattern id="ocean-dots" width="46" height="46" patternUnits="userSpaceOnUse">
            <circle cx="6" cy="8" r="1" fill="#3d6b96" opacity="0.35" />
            <circle cx="30" cy="30" r="1" fill="#3d6b96" opacity="0.25" />
          </pattern>
          <filter id="soft-glow" x="-50%" y="-50%" width="200%" height="200%">
            <feGaussianBlur stdDeviation="4" result="b" />
            <feMerge><feMergeNode in="b" /><feMergeNode in="SourceGraphic" /></feMerge>
          </filter>
        </defs>

        <rect x="0" y="0" width="1000" height="700" fill="url(#sea)" id="ocean" />
        <rect x="0" y="0" width="1000" height="700" fill="url(#ocean-dots)" />

        <!-- ======= DARK CONTINENT LAYER ======= -->
        <g id="dark-layer" opacity="0">
          <rect x="0" y="0" width="1000" height="700" fill="#070d17" />
          <ellipse cx="500" cy="362" rx="336" ry="258" fill="url(#dark-sea)" />
          <!-- mobius ripples -->
          <g fill="none" stroke="#2c4a72" opacity="0.5">
            <ellipse class="ripple r1" cx="500" cy="362" rx="220" ry="168" stroke-width="1.5" />
            <ellipse class="ripple r2" cx="500" cy="362" rx="272" ry="208" stroke-width="1.2" />
            <ellipse class="ripple r3" cx="500" cy="362" rx="316" ry="242" stroke-width="1" />
          </g>
          <!-- the dark continent ring: jagged coast -->
          <path
            d="M0,0 H1000 V700 H0 Z
               M500,116 C 560,112 622,128 678,150 C 740,176 798,222 826,280 C 850,330 852,392 830,444
               C 804,506 748,560 678,588 C 620,612 556,622 496,620 C 430,618 364,600 310,566
               C 252,530 204,478 184,414 C 166,356 172,296 202,244 C 236,186 296,146 364,128
               C 408,116 452,118 500,116 Z"
            fill="#10160f" fill-rule="evenodd"
          />
          <path
            d="M500,116 C 560,112 622,128 678,150 C 740,176 798,222 826,280 C 850,330 852,392 830,444
               C 804,506 748,560 678,588 C 620,612 556,622 496,620 C 430,618 364,600 310,566
               C 252,530 204,478 184,414 C 166,356 172,296 202,244 C 236,186 296,146 364,128
               C 408,116 452,118 500,116 Z"
            fill="none" stroke="#2b3b26" stroke-width="4" stroke-dasharray="1 7" stroke-linecap="round"
          />
          <!-- dark terrain: twisted forests and peaks -->
          <g fill="#182114">
            <path d="M120 90 l30 -44 26 34 22 -40 30 50 z" />
            <path d="M700 60 l26 -38 22 30 20 -34 28 44 z" />
            <path d="M880 220 l24 -36 20 28 18 -30 26 40 z" />
            <path d="M60 560 l28 -40 22 32 20 -36 28 46 z" />
            <path d="M830 580 l26 -38 22 30 18 -32 28 42 z" />
          </g>
          <g fill="#1d2818" opacity="0.9">
            <circle cx="180" cy="180" r="34" /><circle cx="146" cy="200" r="26" /><circle cx="216" cy="204" r="24" />
            <circle cx="820" cy="160" r="30" /><circle cx="860" cy="184" r="24" />
            <circle cx="920" cy="480" r="34" /><circle cx="884" cy="510" r="26" />
            <circle cx="150" cy="640" r="30" /><circle cx="200" cy="660" r="24" />
            <circle cx="640" cy="656" r="28" /><circle cx="380" cy="662" r="26" />
          </g>
          <!-- calamity glows -->
          <g class="calamity-glows">
            <circle cx="240" cy="120" r="60" fill="url(#calamity-glow)" class="cal-glow" />
            <circle cx="762" cy="118" r="60" fill="url(#calamity-glow)" class="cal-glow" style="animation-delay:-1s" />
            <circle cx="872" cy="400" r="60" fill="url(#calamity-glow)" class="cal-glow" style="animation-delay:-2s" />
            <circle cx="126" cy="420" r="60" fill="url(#calamity-glow)" class="cal-glow" style="animation-delay:-3s" />
            <circle cx="500" cy="628" r="60" fill="url(#calamity-glow)" class="cal-glow" style="animation-delay:-1.5s" />
          </g>
          <!-- gateway door -->
          <g transform="translate(500 208)">
            <path d="M-26 26 v-30 a26 26 0 0 1 52 0 v30 z" fill="#151d2c" stroke="#f4c95d" stroke-width="2.5" />
            <path d="M0 26 v-52 M-13 26 v-40 M13 26 v-40" stroke="#f4c95d" stroke-width="1.2" opacity="0.6" />
          </g>
          <text x="500" y="76" text-anchor="middle" class="map-title dark-title">THE DARK CONTINENT</text>
          <text x="500" y="556" text-anchor="middle" class="map-sub">LAKE MOBIUS</text>
          <text x="500" y="578" text-anchor="middle" class="map-sub-small">— the "ocean" of the known world —</text>
        </g>

        <!-- ======= KNOWN WORLD ======= -->
        <g id="known-world">
          <!-- meridian grid -->
          <g id="kw-grid" fill="none" stroke="#2f5b85" stroke-width="1" opacity="0.3">
            <path d="M500 20 C 200 20 60 180 60 350 C 60 520 200 680 500 680 C 800 680 940 520 940 350 C 940 180 800 20 500 20 Z" />
            <path d="M500 20 C 350 20 280 180 280 350 C 280 520 350 680 500 680 C 650 680 720 520 720 350 C 720 180 650 20 500 20 Z" />
            <path d="M500 20 V 680" />
            <path d="M64 350 H 936" />
            <path d="M96 200 Q 500 130 904 200" />
            <path d="M96 500 Q 500 570 904 500" />
          </g>

          <!-- sea routes -->
          <g id="kw-routes" fill="none" stroke="#7fb3d9" stroke-width="2" opacity="0.5" stroke-linecap="round">
            <path class="route" d="M618 470 C 640 420 660 350 700 280" stroke-dasharray="4 9" />
            <path class="route" d="M618 470 C 560 460 480 420 448 360" stroke-dasharray="4 9" style="animation-delay:-2s" />
            <path class="route" d="M540 548 C 460 560 340 560 290 545" stroke-dasharray="4 9" style="animation-delay:-4s" />
          </g>

          <g id="kw-land">
            <!-- Azian continent -->
            <path d="M118,212 C 128,178 162,152 204,148 C 238,144 268,132 304,138 C 342,144 368,164 396,172
                     C 428,180 452,196 462,226 C 472,254 460,278 472,304 C 484,330 502,348 496,378
                     C 490,408 462,428 428,430 C 400,432 380,452 348,452 C 310,452 282,432 246,426
                     C 210,420 182,396 166,364 C 150,332 122,318 112,286 C 104,258 110,236 118,212 Z"
              fill="url(#land-a)" stroke="#57a06c" stroke-width="2.5" stroke-linejoin="round" />
            <!-- inner highland -->
            <path d="M180,230 C 200,200 260,184 310,194 C 360,204 408,224 420,258 C 430,288 414,318 380,330
                     C 340,344 280,340 240,320 C 200,300 168,264 180,230 Z" fill="#3f8556" opacity="0.55" />
            <!-- Yorbian continent -->
            <path d="M612,148 C 640,124 686,112 728,120 C 768,128 806,144 836,172 C 868,202 886,242 878,282
                     C 870,318 844,342 838,378 C 832,412 806,436 770,440 C 736,444 706,428 682,404
                     C 658,380 652,348 644,318 C 636,288 610,268 606,236 C 602,204 594,168 612,148 Z"
              fill="url(#land-b)" stroke="#57a06c" stroke-width="2.5" stroke-linejoin="round" />
            <path d="M660,180 C 690,158 740,152 780,168 C 820,184 844,214 840,250 C 836,282 810,300 776,302
                     C 738,304 700,290 680,262 C 662,236 646,204 660,180 Z" fill="#4a9162" opacity="0.5" />
            <!-- Mitene Union -->
            <path d="M146,466 C 168,438 214,428 256,436 C 296,444 330,462 342,494 C 354,526 340,560 308,580
                     C 276,600 228,604 192,590 C 158,576 132,548 128,516 C 126,496 132,480 146,466 Z"
              fill="url(#land-a)" stroke="#57a06c" stroke-width="2.5" stroke-linejoin="round" />
            <!-- Begerossé -->
            <path d="M428,516 C 452,496 496,490 534,500 C 570,510 594,532 590,562 C 586,590 556,608 518,610
                     C 482,612 446,600 430,574 C 418,554 414,532 428,516 Z"
              fill="url(#land-b)" stroke="#57a06c" stroke-width="2.5" stroke-linejoin="round" />
            <!-- Ochima islands -->
            <path d="M900,416 c 26,-10 54,4 52,28 c -2,22 -32,32 -52,20 c -18,-11 -20,-40 0,-48 Z" fill="url(#land-a)" stroke="#57a06c" stroke-width="2" />
            <circle cx="932" cy="500" r="9" fill="url(#land-a)" stroke="#57a06c" stroke-width="2" />
            <!-- Whale island: whale-shaped -->
            <path d="M596,470 c 4,-14 20,-22 34,-18 c 10,3 16,10 18,18 c 6,-6 14,-8 20,-4 c -4,6 -10,8 -12,14
                     c -4,10 -16,16 -30,14 c -16,-2 -32,-10 -30,-24 z" fill="url(#land-b)" stroke="#57a06c" stroke-width="2" />
            <!-- Greed island -->
            <circle cx="540" cy="548" r="15" fill="url(#land-b)" stroke="#57a06c" stroke-width="2" />

            <!-- terrain details -->
            <g stroke="#2c6841" stroke-width="2.5" stroke-linecap="round" fill="none" opacity="0.9">
              <path d="M200 250 l10 -16 10 16 M225 244 l9 -14 9 14 M250 252 l10 -16 10 16" />
              <path d="M700 200 l10 -16 10 16 M726 194 l9 -14 9 14" />
              <path d="M170 500 l9 -14 9 14 M192 494 l8 -12 8 12" />
            </g>
            <path d="M448 348 l12 -22 12 22 z" fill="#6b4fae" stroke="#8e6fd0" stroke-width="2" />
            <g fill="#2c6841" opacity="0.85">
              <circle cx="330" cy="390" r="9" /><circle cx="348" cy="398" r="7" /><circle cx="316" cy="400" r="6" />
              <circle cx="770" cy="380" r="9" /><circle cx="788" cy="390" r="6" />
              <circle cx="250" cy="540" r="8" /><circle cx="268" cy="550" r="6" />
              <circle cx="480" cy="560" r="6" /><circle cx="500" cy="568" r="5" />
            </g>
            <!-- rivers -->
            <g stroke="#3d8fb5" stroke-width="2" fill="none" opacity="0.8" stroke-linecap="round">
              <path d="M300 200 C 310 240 290 280 310 320 C 320 340 340 360 336 390" />
              <path d="M760 220 C 750 260 770 300 750 340 C 742 356 730 372 732 392" />
            </g>
            <!-- heavens arena tower -->
            <g transform="translate(385 250)">
              <path d="M-5 12 h10 l-2 -26 h-6 z" fill="#58b3e0" stroke="#8fd0ef" stroke-width="1.5" />
              <path d="M0 -14 v-6" stroke="#8fd0ef" stroke-width="2" stroke-linecap="round" />
            </g>
          </g>

          <g id="kw-labels">
            <text x="290" y="300" class="land-label">AZIAN CONTINENT</text>
            <text x="745" y="290" class="land-label">YORBIAN CONTINENT</text>
            <text x="238" y="528" class="land-label">MITENE UNION</text>
            <text x="508" y="590" class="land-label label-s">BEGEROSSÉ</text>
            <text x="924" y="392" class="land-label label-s">OCHIMA</text>
            <text x="500" y="660" class="sea-label">— T H E &nbsp; G R E A T &nbsp; S E A —</text>
          </g>

          <!-- sea monster -->
          <g id="sea-monster" opacity="0.75">
            <path d="M820 590 q14 -26 34 -8 q-16 2 -20 14 z" fill="#2f5b85" />
            <path d="M866 596 q10 -18 26 -6 q-12 2 -15 11 z" fill="#2f5b85" />
            <path d="M900 600 q8 -14 20 -5 q-9 2 -11 9 z" fill="#2f5b85" />
            <circle cx="836" cy="588" r="1.8" fill="#0a1626" />
          </g>

          <!-- compass rose -->
          <g id="compass" transform="translate(90 96)">
            <circle r="34" fill="#0d2036" stroke="#3d6b96" stroke-width="1.5" />
            <circle r="26" fill="none" stroke="#3d6b96" stroke-width="0.8" opacity="0.7" />
            <g id="compass-needle">
              <path d="M0 -28 L7 0 L0 6 L-7 0 Z" fill="#e63946" />
              <path d="M0 28 L7 0 L0 -6 L-7 0 Z" fill="#cfd8e6" />
            </g>
            <text y="-38" text-anchor="middle" class="compass-letter">N</text>
            <text y="50" text-anchor="middle" class="compass-letter">S</text>
            <text x="44" y="5" text-anchor="middle" class="compass-letter">E</text>
            <text x="-44" y="5" text-anchor="middle" class="compass-letter">W</text>
          </g>

          <!-- cartouche -->
          <g id="cartouche" transform="translate(1000 700)">
            <rect x="-296" y="-76" width="272" height="58" rx="6" fill="#0d2036" stroke="#3d6b96" stroke-width="1.5" opacity="0.92" />
            <text x="-160" y="-52" text-anchor="middle" class="cartouche-title">HUNTER ASSOCIATION</text>
            <text x="-160" y="-32" text-anchor="middle" class="cartouche-sub">OFFICIAL SURVEY · V5 APPROVED EDITION</text>
          </g>

          <!-- known world markers -->
          <g id="kw-markers">
            {knownPlaces.map((p) => (
              <g class="marker" data-place={p.id} tabindex="0" role="button" aria-label={p.name} style={`--mc:${p.color}`}>
                <circle cx={p.x} cy={p.y} r="15" class="marker-halo" />
                <path d={`M${p.x} ${p.y - 31} c 6.5 0 11 4.8 11 11 c 0 8 -11 20 -11 20 c 0 0 -11 -12 -11 -20 c 0 -6.2 4.5 -11 11 -11 z`} class="marker-pin" />
                <circle cx={p.x} cy={p.y - 19} r="4" class="marker-hole" />
                <text x={p.x} y={p.y - 38} text-anchor="middle" class="marker-label">{p.name}</text>
              </g>
            ))}
          </g>
        </g>

        <!-- dark continent markers -->
        <g id="dc-markers" opacity="0">
          {darkPlaces.map((p) => (
            <g class="marker" data-place={p.id} tabindex="-1" role="button" aria-label={p.name} style={`--mc:${p.color}`}>
              <circle cx={p.x} cy={p.y} r="15" class="marker-halo" />
              <path d={`M${p.x} ${p.y - 31} c 6.5 0 11 4.8 11 11 c 0 8 -11 20 -11 20 c 0 0 -11 -12 -11 -20 c 0 -6.2 4.5 -11 11 -11 z`} class="marker-pin" />
              <circle cx={p.x} cy={p.y - 19} r="4" class="marker-hole" />
              <text x={p.x} y={p.y - 38} text-anchor="middle" class="marker-label">{p.name}</text>
            </g>
          ))}
        </g>

        <!-- vignette -->
        <rect x="0" y="0" width="1000" height="700" fill="none" stroke="#05080e" stroke-width="26" opacity="0.55" />
        <rect x="10" y="10" width="980" height="680" fill="none" stroke="#3d6b96" stroke-width="1.5" opacity="0.5" />
      </svg>

      <!-- info panel -->
      <aside class="map-info" id="map-info">
        <div class="mi-empty" id="mi-empty">
          <p>▸ Select a marker on the map to read the Association's field notes.</p>
        </div>
        <div class="mi-detail" id="mi-detail" hidden>
          <h3 id="mi-name"></h3>
          <p id="mi-text"></p>
        </div>
      </aside>
    </div>

    <p class="map-footnote" id="dark-footnote" hidden>
      The "world map" every civilian knows is the small green smudge in the middle. Lake Mobius —
      what they call "the ocean" — is a lake. The land beyond has returned 149 expeditions as
      corpses, madmen, or not at all. The Hunter Association keeps the door anyway.
    </p>
  </section>
</Base>

<script define:vars={{ knownPlaces, darkPlaces }}>
  window.__MAP_PLACES__ = [...knownPlaces, ...darkPlaces];
</script>

<style>
  .page-head { padding: 3.2rem 0 1.4rem; text-align: center; }
  .page-sub { color: var(--text-dim); max-width: 560px; margin: 0 auto 1.4rem; }

  .view-toggle { display: inline-flex; gap: 0.5rem; }
  .vt-btn {
    font-family: var(--font-display);
    font-size: 1rem;
    letter-spacing: 0.05em;
    padding: 0.6rem 1.4rem;
    border-radius: 10px;
    border: 2px solid var(--line);
    background: var(--panel);
    color: var(--text-dim);
    transition: all 0.25s;
  }
  .vt-btn:hover { transform: translateY(-2px); color: var(--text); }
  .vt-btn.active { border-color: var(--hxh-green); color: var(--hxh-green); box-shadow: 0 0 18px -6px var(--hxh-green); }
  .vt-dark.active { border-color: var(--hxh-red); color: var(--hxh-red); box-shadow: 0 0 22px -6px var(--hxh-red); animation: flicker 2.2s linear infinite; }

  .map-frame {
    display: grid;
    grid-template-columns: 1fr 300px;
    overflow: hidden;
  }
  @media (max-width: 900px) { .map-frame { grid-template-columns: 1fr; } }
  .world-map { display: block; width: 100%; height: auto; background: #0a1626; }

  /* ---- known world zoom transition ---- */
  #known-world {
    transform-origin: 500px 362px;
    transition: transform 1.4s cubic-bezier(0.7, 0, 0.3, 1);
  }
  #dark-layer, #dc-markers { transition: opacity 1.2s ease 0.35s; }
  #dc-markers { pointer-events: none; }

  .world-map.dark-mode #known-world { transform: translate(0px, 8px) scale(0.4); }
  .world-map.dark-mode #dark-layer { opacity: 1; }
  .world-map.dark-mode #dc-markers { opacity: 1; pointer-events: auto; }
  .world-map.dark-mode #kw-markers,
  .world-map.dark-mode #kw-labels,
  .world-map.dark-mode #kw-grid,
  .world-map.dark-mode #kw-routes,
  .world-map.dark-mode #compass,
  .world-map.dark-mode #cartouche,
  .world-map.dark-mode #sea-monster { opacity: 0; pointer-events: none; }
  #kw-markers, #kw-labels, #kw-grid, #kw-routes, #compass, #cartouche, #sea-monster { transition: opacity 0.6s; }

  /* ---- decorations ---- */
  .route { animation: route-flow 3.2s linear infinite; }
  @keyframes route-flow { to { stroke-dashoffset: -26; } }

  .ripple { transform-origin: 500px 362px; }
  .r1 { animation: ripple-pulse 6s ease-in-out infinite; }
  .r2 { animation: ripple-pulse 6s ease-in-out infinite -2s; }
  .r3 { animation: ripple-pulse 6s ease-in-out infinite -4s; }
  @keyframes ripple-pulse {
    0%, 100% { opacity: 0.25; transform: scale(0.99); }
    50% { opacity: 0.6; transform: scale(1.01); }
  }

  .cal-glow { animation: cal-breathe 4s ease-in-out infinite; transform-origin: center; transform-box: fill-box; }
  @keyframes cal-breathe {
    0%, 100% { opacity: 0.5; transform: scale(0.92); }
    50% { opacity: 1; transform: scale(1.1); }
  }

  #compass-needle { transform-origin: 0 0; animation: needle-sway 7s ease-in-out infinite; }
  @keyframes needle-sway {
    0%, 100% { transform: rotate(-5deg); }
    50% { transform: rotate(6deg); }
  }
  .compass-letter {
    font-family: var(--font-display);
    font-size: 15px;
    fill: #7fb3d9;
  }

  #sea-monster { animation: monster-swim 9s ease-in-out infinite; }
  @keyframes monster-swim {
    0%, 100% { transform: translateX(0); }
    50% { transform: translateX(-22px); }
  }

  .cartouche-title { font-family: var(--font-display); font-size: 17px; fill: #cfe0ef; letter-spacing: 2px; }
  .cartouche-sub { font-family: var(--font-body); font-size: 9px; font-weight: 700; fill: #6e93b5; letter-spacing: 1.4px; }

  .map-title {
    font-family: var(--font-display);
    font-size: 42px;
    letter-spacing: 7px;
    fill: #8a3b47;
    filter: url(#soft-glow);
  }
  .dark-title { fill: #99424e; }
  .map-sub {
    font-family: var(--font-display);
    font-size: 22px;
    fill: #4a6f94;
    letter-spacing: 8px;
  }
  .map-sub-small { font-family: var(--font-body); font-size: 12px; fill: #3d5c7c; font-style: italic; letter-spacing: 2px; }
  .land-label {
    font-family: var(--font-body);
    font-weight: 700;
    font-size: 15px;
    letter-spacing: 3px;
    fill: #a6d9b5;
    text-anchor: middle;
    paint-order: stroke;
    stroke: #12301e;
    stroke-width: 3px;
    opacity: 0.95;
  }
  .label-s { font-size: 11px; }
  .sea-label {
    font-family: var(--font-body);
    font-weight: 700;
    font-size: 13px;
    letter-spacing: 4px;
    fill: #4a7aa5;
    text-anchor: middle;
    font-style: italic;
  }

  /* ---- markers ---- */
  .marker { cursor: pointer; outline: none; }
  .marker-pin {
    fill: var(--mc);
    stroke: #0b0d12;
    stroke-width: 2;
    transition: transform 0.2s;
    transform-origin: center bottom;
    transform-box: fill-box;
  }
  .marker-hole { fill: #0b0d12; pointer-events: none; }
  .marker:hover .marker-pin, .marker:focus-visible .marker-pin { transform: scale(1.12); }
  .marker-halo {
    fill: none;
    stroke: var(--mc);
    stroke-width: 2;
    opacity: 0;
    transform-origin: center;
    transform-box: fill-box;
  }
  .marker:hover .marker-halo,
  .marker:focus-visible .marker-halo,
  .marker.active .marker-halo { opacity: 1; animation: ring-out 1.5s ease-out infinite; }
  @keyframes ring-out {
    0% { transform: scale(0.6); opacity: 1; }
    100% { transform: scale(1.6); opacity: 0; }
  }
  .marker-label {
    font-family: var(--font-body);
    font-weight: 700;
    font-size: 13.5px;
    fill: var(--text);
    paint-order: stroke;
    stroke: #0b0d12;
    stroke-width: 4px;
    opacity: 0;
    transition: opacity 0.2s;
    pointer-events: none;
  }
  .marker:hover .marker-label,
  .marker:focus-visible .marker-label,
  .marker.active .marker-label { opacity: 1; }

  /* ---- info panel ---- */
  .map-info {
    border-left: 1px solid var(--line);
    padding: 1.6rem;
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-height: 200px;
    background: var(--panel-2);
  }
  @media (max-width: 900px) { .map-info { border-left: 0; border-top: 1px solid var(--line); } }
  .mi-empty { color: var(--text-dim); font-size: 0.92rem; }
  .mi-detail { animation: pop-in 0.35s; }
  .mi-detail h3 { font-size: 1.35rem; color: var(--mi-color, var(--hxh-gold)); }
  .mi-detail p { color: var(--text-dim); font-size: 0.93rem; margin: 0; }

  .map-footnote {
    max-width: 760px;
    margin: 1.6rem auto 0;
    text-align: center;
    color: var(--hxh-red);
    font-size: 0.92rem;
    font-weight: 600;
    animation: pop-in 0.6s;
  }
</style>

<script>
  const places = (window as any).__MAP_PLACES__ as { id: string; name: string; text: string; color: string }[];
  const svg = document.getElementById('world-map')!;
  const btnKnown = document.getElementById('btn-known')!;
  const btnDark = document.getElementById('btn-dark')!;
  const footnote = document.getElementById('dark-footnote')!;
  const miEmpty = document.getElementById('mi-empty')!;
  const miDetail = document.getElementById('mi-detail')!;

  function setView(dark: boolean) {
    svg.classList.toggle('dark-mode', dark);
    btnKnown.classList.toggle('active', !dark);
    btnDark.classList.toggle('active', dark);
    footnote.hidden = !dark;
    document.querySelectorAll('.marker.active').forEach((m) => m.classList.remove('active'));
    miDetail.hidden = true;
    miEmpty.hidden = false;
    document.querySelectorAll<SVGGElement>('#dc-markers .marker').forEach((m) => m.setAttribute('tabindex', dark ? '0' : '-1'));
    document.querySelectorAll<SVGGElement>('#kw-markers .marker').forEach((m) => m.setAttribute('tabindex', dark ? '-1' : '0'));
  }
  btnKnown.addEventListener('click', () => setView(false));
  btnDark.addEventListener('click', () => setView(true));

  function selectPlace(id: string, markerEl: Element) {
    const p = places.find((x) => x.id === id);
    if (!p) return;
    document.querySelectorAll('.marker.active').forEach((m) => m.classList.remove('active'));
    markerEl.classList.add('active');
    miEmpty.hidden = true;
    miDetail.hidden = false;
    (miDetail as HTMLElement).style.setProperty('--mi-color', p.color);
    document.getElementById('mi-name')!.textContent = p.name;
    document.getElementById('mi-text')!.textContent = p.text;
  }

  document.querySelectorAll<SVGGElement>('.marker').forEach((m) => {
    m.addEventListener('click', () => selectPlace(m.dataset.place!, m));
    m.addEventListener('keydown', (e) => {
      const k = (e as KeyboardEvent).key;
      if (k === 'Enter' || k === ' ') {
        e.preventDefault();
        selectPlace(m.dataset.place!, m);
      }
    });
  });
</script>
