---
import Base from '../layouts/Base.astro';
import { knownPlaces, darkPlaces, calamities, legend } from '../data/map.js';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

function withBase(path) {
  if (!path) return null;
  return `${base}${path}`;
}

const known = knownPlaces.map((p) => ({ ...p, image: withBase(p.image) }));
const dark = darkPlaces.map((p) => ({ ...p, image: withBase(p.image) }));
const cals = calamities.map((p) => ({ ...p, image: withBase(p.image) }));

function markerIcon(type, x, y, color) {
  const s = 11;
  if (type === 'city') {
    return `<g class="marker-icon" transform="translate(${x} ${y - 18})">
      <rect x="-8" y="-10" width="6" height="14" rx="1" fill="${color}" stroke="#0b0d12" stroke-width="1.5"/>
      <rect x="1" y="-14" width="7" height="18" rx="1" fill="${color}" stroke="#0b0d12" stroke-width="1.5"/>
      <rect x="-3" y="-4" width="5" height="8" rx="0.5" fill="${color}" stroke="#0b0d12" stroke-width="1.2"/>
    </g>`;
  }
  if (type === 'landmark') {
    return `<g class="marker-icon" transform="translate(${x} ${y - 18})">
      <path d="M-5 10 h10 l-2 -22 h-6 z" fill="${color}" stroke="#0b0d12" stroke-width="1.5"/>
      <path d="M0 -12 v-5" stroke="${color}" stroke-width="2" stroke-linecap="round"/>
    </g>`;
  }
  if (type === 'island') {
    return `<g class="marker-icon" transform="translate(${x} ${y - 16})">
      <ellipse cx="0" cy="2" rx="11" ry="5" fill="${color}" stroke="#0b0d12" stroke-width="1.5"/>
      <path d="M-4 0 q4 -10 10 -2" fill="none" stroke="#0b0d12" stroke-width="1.5"/>
    </g>`;
  }
  if (type === 'conflict') {
    return `<g class="marker-icon" transform="translate(${x} ${y - 16})">
      <path d="M0 -12 L10 8 H-10 Z" fill="${color}" stroke="#0b0d12" stroke-width="1.5"/>
      <text y="5" text-anchor="middle" font-size="10" font-weight="700" fill="#0b0d12" font-family="sans-serif">!</text>
    </g>`;
  }
  // calamity
  return `<g class="marker-icon" transform="translate(${x} ${y - 16})">
    <circle r="${s}" fill="${color}" stroke="#0b0d12" stroke-width="2"/>
    <path d="M-4 -2 L0 5 L4 -2" fill="none" stroke="#0b0d12" stroke-width="2" stroke-linecap="round"/>
  </g>`;
}
---

<Base title="World Map" description="An interactive map of the Hunter x Hunter world — the known continents, and the Dark Continent beyond Lake Mobius.">
  <section class="page-head container">
    <span class="section-kicker">CARTOGRAPHY DIVISION · CLEARANCE LEVEL ★★</span>
    <h1 class="section-title">The <span class="accent-g">World</span> — and What Lies <span class="accent">Beyond</span></h1>
