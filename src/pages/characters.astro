---
import Base from '../layouts/Base.astro';
import CharacterDossiers from '../components/CharacterDossiers';
import { characters as baseCharacters } from '../data/characters';
import { portraitSrc } from '../data/portraits';
import { siteBase } from '../lib/base';

const base = siteBase();
const characters = baseCharacters.map((c) => ({
  ...c,
  portrait: portraitSrc(base, c.id),
}));
---

<Base title="Characters" description="Dossiers on ten Hunter x Hunter characters — Gon, Killua, Kurapika, Leorio, Hisoka, Kite, Chrollo, Netero, Ging and Tonpa.">
  <CharacterDossiers client:load characters={characters} />
</Base>
