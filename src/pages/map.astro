                  <text x="220" y="510" class="land-label label-s">UNION</text>
                  <text x="510" y="595" class="land-label label-s">BEGEROSSÉ</text>
                  <text x="924" y="392" class="land-label label-s">OCHIMA</text>
                  <text x="500" y="660" class="sea-label">— T H E &nbsp; G R E A T &nbsp; S E A —</text>
                </g>

                <g id="sea-monster" opacity="0.7">
                  <path d="M820 590 q14 -26 34 -8 q-16 2 -20 14 z" fill="#2f5b85" />
                  <path d="M866 596 q10 -18 26 -6 q-12 2 -15 11 z" fill="#2f5b85" />
                  <path d="M900 600 q8 -14 20 -5 q-9 2 -11 9 z" fill="#2f5b85" />
                </g>

                <g id="compass" transform="translate(90 96)">
                  <circle r="34" fill="#0d2036" stroke="#3d6b96" stroke-width="1.5" />
                  <circle r="26" fill="none" stroke="#3d6b96" stroke-width="0.8" opacity="0.7" />
                  <g id="compass-needle">
                    <path d="M0 -28 L7 0 L0 6 L-7 0 Z" fill="#e63946" />
                    <path d="M0 28 L7 0 L0 -6 L-7 0 Z" fill="#cfd8e6" />
                  </g>
                  <text y="-38" text-anchor="middle" class="compass-letter">N</text>
                  <text y="50" text-anchor="middle" class="compass-letter">S</text>
                  <text x="44" y="5" text-anchor="middle" class="compass-letter">E</text>
                  <text x="-44" y="5" text-anchor="middle" class="compass-letter">W</text>
                </g>

                <g id="cartouche" transform="translate(1000 700)">
                  <rect x="-296" y="-76" width="272" height="58" rx="6" fill="#0d2036" stroke="#3d6b96" stroke-width="1.5" opacity="0.92" />
