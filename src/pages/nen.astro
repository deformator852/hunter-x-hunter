---
import Base from '../layouts/Base.astro';
import NenGuide from '../components/NenGuide';
import { characters } from '../data/characters';
import { facesByType } from '../data/nen';
import { portraitSrc } from '../data/portraits';
import { siteBase } from '../lib/base';

const base = siteBase();

const faces = Object.fromEntries(
  Object.entries(facesByType).map(([type, ids]) => [
    type,
    ids.map((id) => {
      const c = characters.find((x) => x.id === id)!;
      return {
        id,
        name: c.name.split(' ')[0],
        color: c.color,
        portrait: portraitSrc(base, id),
      };
    }),
  ])
);
---

<Base title="Nen" description="An interactive guide to Nen from Hunter x Hunter: the four principles, six aura types, and the water divination test.">
  <NenGuide client:load faces={faces} charactersHref={`${base}/characters`} />
</Base>
