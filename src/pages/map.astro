                    fill="url(#land-a)" stroke="#57a06c" stroke-width="2.5" stroke-linejoin="round" />
                  <path d="M180,500 C 220,490 260,505 280,535 C 250,545 200,540 180,500 Z" fill="url(#forest-dots)" opacity="0.65" />

