</style>

<script>
  type Place = {
    id: string;
    name: string;
    text: string;
    color: string;
    type?: string;
    rank?: string | null;
    image?: string | null;
  };

  const places = JSON.parse(document.getElementById('map-places-data')!.textContent || '[]') as Place[];
  const svg = document.getElementById('world-map')!;
  const stage = document.getElementById('map-stage')!;
  const viewport = document.getElementById('map-viewport')!;
  const transformEl = document.getElementById('map-transform')!;
  const btnKnown = document.getElementById('btn-known')!;
  const btnDark = document.getElementById('btn-dark')!;
  const footnote = document.getElementById('dark-footnote')!;
  const calamitiesPanel = document.getElementById('calamities-panel')!;
  const overlay = document.getElementById('classified-overlay')!;
  const miEmpty = document.getElementById('mi-empty')!;
  const miDetail = document.getElementById('mi-detail')!;
  const miImgWrap = document.getElementById('mi-img-wrap')!;
  const miImg = document.getElementById('mi-img') as HTMLImageElement;
  const typeLabels: Record<string, string> = {
    city: 'City',
    island: 'Island',
    landmark: 'Landmark',
    conflict: 'Conflict zone',
    calamity: 'Calamity',
  };

  let darkMode = false;
  let scale = 1;
  let tx = 0;
  let ty = 0;
  let dragging = false;
  let lastX = 0;
  let lastY = 0;

  function applyTransform() {
    transformEl.style.transform = `translate(${tx}px, ${ty}px) scale(${scale})`;
  }

  function resetZoom() {
    scale = 1;
    tx = 0;
    ty = 0;
    applyTransform();
  }

  function clampZoom(next: number) {
    return Math.min(3.2, Math.max(1, next));
  }

  document.getElementById('zoom-in')!.addEventListener('click', () => {
    if (darkMode) return;
    scale = clampZoom(scale * 1.25);
    applyTransform();
  });
  document.getElementById('zoom-out')!.addEventListener('click', () => {
    if (darkMode) return;
    scale = clampZoom(scale / 1.25);
    if (scale === 1) { tx = 0; ty = 0; }
    applyTransform();
  });
  document.getElementById('zoom-fit')!.addEventListener('click', () => {
    if (darkMode) return;
    resetZoom();
  });

  function isInteractiveTarget(target: EventTarget | null) {
    const el = target as Element | null;
    if (!el || typeof el.closest !== 'function') return false;
    return Boolean(el.closest('.marker, .zoom-controls, button, a'));
  }

  viewport.addEventListener('pointerdown', (e) => {
    if (darkMode) return;
    if (isInteractiveTarget(e.target)) return;
    dragging = true;
    lastX = e.clientX;
    lastY = e.clientY;
    viewport.classList.add('is-panning');
    viewport.setPointerCapture(e.pointerId);
  });
  viewport.addEventListener('pointermove', (e) => {
    if (!dragging || darkMode) return;
    tx += e.clientX - lastX;
    ty += e.clientY - lastY;
    lastX = e.clientX;
    lastY = e.clientY;
    applyTransform();
  });
  const endPan = () => {
    dragging = false;
    viewport.classList.remove('is-panning');
  };
  viewport.addEventListener('pointerup', endPan);
  viewport.addEventListener('pointercancel', endPan);

  viewport.addEventListener(
    'wheel',
    (e) => {
      if (darkMode) return;
      e.preventDefault();
      const factor = e.deltaY > 0 ? 0.9 : 1.1;
      scale = clampZoom(scale * factor);
      if (scale === 1) { tx = 0; ty = 0; }
      applyTransform();
    },
    { passive: false }
  );

  function clearSelection() {
    document.querySelectorAll('.marker.active').forEach((m) => m.classList.remove('active'));
    miDetail.hidden = true;
    miEmpty.hidden = false;
  }

  function selectPlace(id: string, markerEl?: Element | null) {
    const p = places.find((x) => x.id === id);
    if (!p) return;
    const marker = markerEl || document.querySelector(`.marker[data-place="${id}"]`);
    document.querySelectorAll('.marker.active').forEach((m) => m.classList.remove('active'));
    marker?.classList.add('active');
    miEmpty.hidden = true;
    miDetail.hidden = false;
    miDetail.style.setProperty('--mi-color', p.color);
    document.getElementById('mi-name')!.textContent = p.name;
    document.getElementById('mi-text')!.textContent = p.text;
    document.getElementById('mi-type')!.textContent = p.rank
      ? `${typeLabels[p.type || ''] || 'Location'} · Threat ${p.rank}`
      : typeLabels[p.type || ''] || 'Location';
    if (p.image) {
      miImgWrap.hidden = false;
      miImg.src = p.image;
      miImg.alt = p.name;
    } else {
      miImgWrap.hidden = true;
      miImg.removeAttribute('src');
    }
  }

  async function setView(dark: boolean) {
    if (dark === darkMode) return;
    if (dark) {
      overlay.hidden = false;
      await new Promise((r) => setTimeout(r, 700));
      overlay.hidden = true;
      resetZoom();
    }
    darkMode = dark;
    svg.classList.toggle('dark-mode', dark);
    stage.classList.toggle('dark-view', dark);
    btnKnown.classList.toggle('active', !dark);
    btnDark.classList.toggle('active', dark);
    footnote.hidden = !dark;
    calamitiesPanel.hidden = !dark;
    clearSelection();
    document.querySelectorAll<SVGGElement>('#dc-markers .marker').forEach((m) => m.setAttribute('tabindex', dark ? '0' : '-1'));
    document.querySelectorAll<SVGGElement>('#kw-markers .marker').forEach((m) => m.setAttribute('tabindex', dark ? '-1' : '0'));
  }

  btnKnown.addEventListener('click', () => setView(false));
  btnDark.addEventListener('click', () => setView(true));

  document.querySelectorAll<SVGGElement>('.marker').forEach((m) => {
    m.addEventListener('pointerdown', (e) => {
      e.stopPropagation();
    });
    m.addEventListener('click', (e) => {
      e.stopPropagation();
      e.preventDefault();
      selectPlace(m.dataset.place!, m);
    });
    m.addEventListener('keydown', (e) => {
      const k = (e as KeyboardEvent).key;
      if (k === 'Enter' || k === ' ') {
        e.preventDefault();
        selectPlace(m.dataset.place!, m);
      }
    });
  });

  document.querySelectorAll<HTMLButtonElement>('.cal-row').forEach((btn) => {
    btn.addEventListener('click', () => {
      const id = btn.dataset.place!;
      selectPlace(id);
      document.querySelector(`.marker[data-place="${id}"]`)?.scrollIntoView({ block: 'nearest', inline: 'nearest' });
    });
  });
</script>
