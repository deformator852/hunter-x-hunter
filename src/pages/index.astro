---
import Base from '../layouts/Base.astro';
import { characters, nenTypeColors } from '../data/characters';
import { portraitSrc } from '../data/portraits';
import { siteBase } from '../lib/base';
import HomeEffects from '../components/HomeEffects';
import '../styles/pages/index.css';

const base = siteBase();

const featured = ['gon', 'killua', 'kurapika', 'leorio', 'hisoka'].map((id) => {
  const c = characters.find((x) => x.id === id);
  return { ...c, portrait: portraitSrc(base, id) };
});

const arcs = [
  {
    num: 'I',
    title: 'Hunter Exam',
    color: 'var(--hxh-green)',
    text: 'Gon, Kurapika and Leorio survive a marathon through a swamp of liars, a chef with impossible standards, and a tower full of killers — and meet a boy named Killua.',
  },
  {
    num: 'II',
    title: 'Heavens Arena',
    color: 'var(--hxh-blue)',
    text: 'A 251-floor tower where fighters earn money with their fists. On floor 200, Gon and Killua hit a wall called Nen — and a magician waiting for them to ripen.',
  },
  {
    num: 'III',
    title: 'Yorknew City',
    color: 'var(--hxh-red)',
    text: 'The world\'s biggest auction draws mafia, thieves and Hunters. Kurapika\'s chains finally meet the Phantom Troupe. Nobody walks away unchanged.',
  },
  {
    num: 'IV',
    title: 'Greed Island',
    color: 'var(--hxh-gold)',
    text: 'A game console that costs billions — because the game is real. Gon and Killua train under Biscuit and learn that cards, rules and Nen make a deadly combination.',
  },
  {
    num: 'V',
    title: 'Chimera Ant',
    color: 'var(--hxh-purple)',
    text: 'An insect queen washes ashore and begins eating humans — and birthing something new. The darkest arc in the story asks what actually separates monster from man.',
  },
  {
    num: 'VI',
    title: '13th Chairman Election',
    color: 'var(--hxh-pink)',
    text: 'The Association must replace the irreplaceable. The Zoldyck brothers play their own game, and Gon finally meets the man he\'s been chasing all along.',
  },
];
---

<Base title="Home">
  <!-- ================= HERO ================= -->
  <section class="hero">
    <canvas id="aura-canvas" aria-hidden="true"></canvas>
    <div class="hero-inner container">
      <p class="hero-kicker">A FAN TRIBUTE TO YOSHIHIRO TOGASHI'S MASTERPIECE</p>
      <h1 class="hero-title hxh-letters" aria-label="Hunter x Hunter">
        {'HUNTER×HUNTER'.split('').map((ch, i) => (
          <span style={`animation-delay:${i * 0.055}s`}>{ch}</span>
        ))}
      </h1>
      <p class="hero-sub">
        Hunters are licensed elites who chase the unknown — beasts, ruins, criminals, riches…
        and sometimes a father who left a game behind instead of a goodbye.
      </p>
      <div class="hero-cta">
        <a class="btn btn-red" href={`${base}/characters`}>Meet the Hunters</a>
        <a class="btn btn-green" href={`${base}/nen`}>Learn Nen</a>
        <a class="btn btn-ghost" href={`${base}/map`}>Explore the World</a>
      </div>
    </div>
    <div class="hero-fade" aria-hidden="true"></div>
  </section>

  <!-- ================= WHAT IS A HUNTER ================= -->
  <section class="section container">
    <span class="section-kicker reveal">CHAPTER 1</span>
    <h2 class="section-title reveal">What is a <span class="accent-g">Hunter</span>?</h2>
    <div class="license-row">
      <div class="license-copy reveal">
        <p>
          Fewer than one in ten thousand applicants survives the Hunter Exam. Those who do receive a
          <strong>Hunter License</strong> — a card that opens 90% of the world's doors: free travel,
          legal immunity in most countries, access to restricted zones, and enough resale value to
          fund seven ordinary lifetimes.
        </p>
        <p>
          But the license is just paper. What makes a Hunter is the hunt itself: gourmet Hunters chase
          impossible flavors, ruins Hunters chase lost civilizations, blacklist Hunters chase the
          world's worst criminals. And a boy from Whale Island chases the one Hunter who never came home.
        </p>
        <p class="license-hint">↪ Hover the license — it's yours now.</p>
      </div>
      <div class="license-card reveal reveal-delay-1" id="license-card" tabindex="0" aria-label="Interactive Hunter License card">
        <div class="license-shine" aria-hidden="true"></div>
        <div class="license-top">
          <svg viewBox="0 0 40 40" class="license-x" aria-hidden="true">
            <g stroke-linecap="round" stroke-width="7">
              <line x1="8" y1="8" x2="32" y2="32" stroke="#e63946" />
              <line x1="32" y1="8" x2="8" y2="32" stroke="#2b6e3f" />
            </g>
          </svg>
          <div>
            <div class="license-label">HUNTER ASSOCIATION</div>
            <div class="license-title">HUNTER LICENSE</div>
          </div>
        </div>
        <div class="license-body">
          <div class="license-photo" aria-hidden="true">
            <svg viewBox="0 0 60 60">
              <circle cx="30" cy="22" r="11" fill="#2b6e3f" />
              <path d="M10 54 c2 -14 10 -20 20 -20 s18 6 20 20z" fill="#2b6e3f" />
            </svg>
          </div>
          <div class="license-fields">
            <div><span>NAME</span> YOU, THE VISITOR</div>
            <div><span>CLASS</span> ROOKIE ★</div>
            <div><span>ID</span> №&nbsp;289-1998-0316</div>
            <div><span>ISSUED</span> 287th HUNTER EXAM</div>
          </div>
        </div>
        <div class="license-strip" aria-hidden="true"></div>
      </div>
    </div>
  </section>

  <!-- ================= WHALE ISLAND PANORAMA ================= -->
  <section class="section container">
    <figure class="panorama card reveal" aria-label="Whale Island from Hunter × Hunter episode 1">
      <div class="panorama-media">
        <img
          class="panorama-img"
          src={`${base}/images/whale-island.webp`}
          alt="Gon Freecss catching the Master of the Swamp near Whale Island"
          width="1920"
          height="1080"
          loading="lazy"
        />
        <div class="panorama-grade" aria-hidden="true"></div>
      </div>
      <figcaption class="panorama-caption">
        <span class="panorama-kicker">EPISODE 1</span>
        Whale Island — where a nine-year-old kept a promise to a fish, and the whole story began.
      </figcaption>
    </figure>
  </section>

  <!-- ================= FEATURED CHARACTERS ================= -->
  <section class="section container">
    <span class="section-kicker reveal">CHAPTER 2</span>
    <h2 class="section-title reveal">The <span class="accent-g">Main</span> Party</h2>
    <div class="featured-row">
      {featured.map((c, i) => (
        <a class={`featured card reveal ${i % 2 ? 'reveal-delay-2' : 'reveal-delay-1'}`} href={`${base}/characters`} style={`--cc:${c.color}`}>
          <span class="featured-art">
            <img src={c.portrait} alt={c.name} width="160" height="180" loading="lazy" />
          </span>
          <span class="featured-name">{c.name.split(' ')[0]}</span>
          <span class="featured-nen" style={`--nc:${nenTypeColors[c.nenType]}`}>{c.nenType}</span>
        </a>
      ))}
    </div>
    <p class="featured-more reveal"><a href={`${base}/characters`}>All ten dossiers, with stats and abilities →</a></p>
  </section>

  <!-- ================= STORY ARCS ================= -->
  <section class="section container">
    <span class="section-kicker reveal">CHAPTER 3</span>
    <h2 class="section-title reveal">The <span class="accent">Journey</span> So Far</h2>
    <ol class="arcs">
      {arcs.map((arc, i) => (
        <li class={`arc card reveal ${i % 2 ? 'reveal-delay-2' : 'reveal-delay-1'}`} style={`--arc-color:${arc.color}`}>
          <div class="arc-num" aria-hidden="true">{arc.num}</div>
          <div>
            <h3 class="arc-title">{arc.title}</h3>
            <p class="arc-text">{arc.text}</p>
          </div>
        </li>
      ))}
    </ol>
  </section>

  <!-- ================= NUMBERS ================= -->
  <section class="section container">
    <div class="numbers card reveal">
      <div class="num-item"><span class="num" data-count="6">0</span><span class="num-label">Nen categories</span></div>
      <div class="num-item"><span class="num" data-count="251">0</span><span class="num-label">Floors of Heavens Arena</span></div>
      <div class="num-item"><span class="num" data-count="100">0</span><span class="num-label">Hands of the Guanyin</span></div>
      <div class="num-item"><span class="num" data-count="35">0</span><span class="num-label">Tonpa's failed exams</span></div>
    </div>
  </section>

  <!-- ================= EXPLORE ================= -->
  <section class="section container">
    <span class="section-kicker reveal">KEEP HUNTING</span>
    <h2 class="section-title reveal">Choose Your <span class="accent-g">Next</span> Hunt</h2>
    <div class="explore-grid">
      <a class="explore card reveal" href={`${base}/characters`} style="--glow:#e63946">
        <span class="explore-icon" aria-hidden="true">
          <svg viewBox="0 0 48 48"><circle cx="24" cy="16" r="9" fill="none" stroke="currentColor" stroke-width="4"/><path d="M8 42 c2 -11 8 -17 16 -17 s14 6 16 17" fill="none" stroke="currentColor" stroke-width="4" stroke-linecap="round"/></svg>
        </span>
        <h3>Characters</h3>
        <p>Ten Hunters, assassins, thieves and one professional rookie-crusher — with dossiers and stats.</p>
        <span class="explore-go">Open the dossiers →</span>
      </a>
      <a class="explore card reveal reveal-delay-1" href={`${base}/nen`} style="--glow:#4fbf67">
        <span class="explore-icon" aria-hidden="true">
          <svg viewBox="0 0 48 48"><path d="M24 4 L41 14 v20 L24 44 L7 34 V14 Z" fill="none" stroke="currentColor" stroke-width="4" stroke-linejoin="round"/><circle cx="24" cy="24" r="6" fill="currentColor"/></svg>
        </span>
        <h3>Nen</h3>
        <p>The life energy system explained the way the anime taught it — plus a water divination test.</p>
        <span class="explore-go">Awaken your aura →</span>
      </a>
      <a class="explore card reveal reveal-delay-2" href={`${base}/map`} style="--glow:#58b3e0">
        <span class="explore-icon" aria-hidden="true">
          <svg viewBox="0 0 48 48"><circle cx="24" cy="24" r="18" fill="none" stroke="currentColor" stroke-width="4"/><path d="M6 24 h36 M24 6 c8 9 8 27 0 36 c-8 -9 -8 -27 0 -36" fill="none" stroke="currentColor" stroke-width="3"/></svg>
        </span>
        <h3>World Map</h3>
        <p>The known world — and the terrifying truth about what surrounds it beyond Lake Mobius.</p>
        <span class="explore-go">Chart the unknown →</span>
      </a>
      <a class="explore card reveal reveal-delay-3" href={`${base}/contact`} style="--glow:#f4c95d">
        <span class="explore-icon" aria-hidden="true">
          <svg viewBox="0 0 48 48"><path d="M8 14 h32 v22 H8 Z" fill="none" stroke="currentColor" stroke-width="4" stroke-linejoin="round"/><path d="M8 16 L24 28 L40 16" fill="none" stroke="currentColor" stroke-width="4" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </span>
        <h3>Contact</h3>
        <p>Open a channel to the hunter who built this site — GitHub and LinkedIn.</p>
        <span class="explore-go">Send a signal →</span>
      </a>
    </div>
  </section>
  <HomeEffects client:load />
</Base>
